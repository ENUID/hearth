{
  "name": "Hearth",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Hearth", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install && npm run install:all && npm run build",
  "postStartCommand": "nohup bash -lc 'PORT=8080 HOME=$HOME node server/dist/index.js' > /tmp/hearth.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
