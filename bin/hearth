#!/usr/bin/env node
/* hearth — chat with your workspace's model, right in the terminal.
 *
 *   hearth                  interactive chat with a branded start screen
 *   hearth ask "question"   one-shot: print the answer and exit
 *   hearth "question"       same as ask
 *
 * In interactive mode:
 *   /model      pick + start a model (the ✦ catalog, in the terminal)
 *   /agents     install + run a CLI agent (the ◆ catalog, in the terminal)
 *   /clear      clear the conversation
 *   /help       commands
 *   Ctrl-D      exit
 *
 * Talks to the OpenAI-compatible endpoint Hearth exposes ($HEARTH_MODEL_URL),
 * plus the models API for the picker. Terminal and model, as one.
 */
const readline = require("readline");
const path = require("path");

// --- endpoints --------------------------------------------------------------
const V1 = (process.env.HEARTH_MODEL_URL || "http://localhost:3001/api/models/v1").replace(/\/$/, "");
const MODELS_API = V1.replace(/\/v1$/, ""); // .../api/models
const AGENTS_API = MODELS_API.replace(/\/models$/, "/agents"); // .../api/agents
const KEY = process.env.HEARTH_MODEL_KEY || process.env.HEARTH_TOKEN || "hearth";
const WS = process.env.HEARTH_WORKSPACE || "workspace";
const VERSION = (() => { try { return require(path.join(__dirname, "..", "package.json")).version; } catch { return "0.1.0"; } })();

// --- ANSI palette (ember) ---------------------------------------------------
const isTTY = process.stdout.isTTY;
const A = (code) => (s) => (isTTY ? `\x1b[${code}m${s}\x1b[0m` : String(s));
const ember = A("38;2;255;122;69");   // accent
const amber = A("38;2;255;180;84");   // accent-2
const bold = A("1");
const dim = A("2");
const emberBold = (s) => (isTTY ? `\x1b[1m\x1b[38;2;255;122;69m${s}\x1b[0m` : String(s));
const CLR = "\x1b[0m";

// The Hearth mark, in box-drawing — a terminal window with an ember prompt.
function logo() {
  if (!isTTY) return ["  hearth"];
  return [
    ember("╭──────╮"),
    ember("│ ") + emberBold("›") + amber("▁") + ember("   │"),
    ember("╰──────╯"),
  ];
}

// --- models API -------------------------------------------------------------
async function snapshot() {
  try {
    const r = await fetch(`${MODELS_API}?ws=${encodeURIComponent(WS)}`, { headers: { authorization: `Bearer ${KEY}` } });
    if (!r.ok) return null;
    return await r.json(); // { catalog, running, backend, apiPath }
  } catch { return null; }
}
async function startModel(id) {
  const r = await fetch(`${MODELS_API}/start`, {
    method: "POST",
    headers: { "content-type": "application/json", authorization: `Bearer ${KEY}` },
    body: JSON.stringify({ modelId: id, ws: WS }),
  });
  if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || `HTTP ${r.status}`);
  return (await r.json()).running;
}

// --- chat streaming ---------------------------------------------------------
async function stream(messages) {
  let res;
  try {
    res = await fetch(`${V1}/chat/completions`, {
      method: "POST",
      headers: { "content-type": "application/json", authorization: `Bearer ${KEY}` },
      body: JSON.stringify({ ws: WS, messages, stream: true }),
    });
  } catch (e) {
    process.stdout.write(`\n${dim(`can't reach the model at ${V1} (${e.message})`)}\n`);
    return "";
  }
  if (!res.ok) {
    if (res.status === 409) process.stdout.write(`\n${amber("no model is running.")} ${dim("Type")} ${emberBold("/model")} ${dim("to start one.")}\n`);
    else process.stdout.write(`\n${dim(`error ${res.status}: ${(await res.text().catch(() => "")).slice(0, 200)}`)}\n`);
    return "";
  }
  const reader = res.body.getReader();
  const dec = new TextDecoder();
  let acc = "", buf = "";
  for (;;) {
    const { value, done } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    const lines = buf.split("\n");
    buf = lines.pop();
    for (const line of lines) {
      if (!line.startsWith("data:")) continue;
      const p = line.slice(5).trim();
      if (p === "[DONE]") continue;
      try {
        const d = JSON.parse(p).choices?.[0]?.delta?.content;
        if (d) { process.stdout.write(d); acc += d; }
      } catch { /* keepalive */ }
    }
  }
  process.stdout.write("\n");
  return acc;
}

// --- agents API -------------------------------------------------------------
async function agentsSnapshot() {
  try {
    const r = await fetch(AGENTS_API, { headers: { authorization: `Bearer ${KEY}` } });
    if (!r.ok) return null;
    const { catalog } = await r.json();
    const installed = await fetch(`${AGENTS_API}/status`, { headers: { authorization: `Bearer ${KEY}` } })
      .then((x) => (x.ok ? x.json() : { installed: {} }))
      .then((s) => s.installed || {})
      .catch(() => ({}));
    return { catalog, installed };
  } catch { return null; }
}

// Run a shell command in this terminal (install or launch an agent). Inherits
// the real TTY, so interactive agents take over the screen; resolves on exit.
// `freeModel` points OpenAI-compatible agents at the workspace's own model.
function runShell(cmd, freeModel) {
  return new Promise((resolve) => {
    const { spawn } = require("child_process");
    const env = { ...process.env };
    if (freeModel) { env.OPENAI_BASE_URL = V1; env.OPENAI_API_BASE = V1; env.OPENAI_API_KEY = KEY; }
    const child = spawn(cmd, { shell: true, stdio: "inherit", env });
    child.on("error", (e) => { process.stdout.write(`\n${dim("couldn't run: " + e.message)}\n`); resolve(); });
    child.on("exit", () => resolve());
  });
}

// --- interactive picker (raw mode) ------------------------------------------
// A fixed-height window over a (possibly long) list, redrawn in place.
// rows: [{ title, meta, blurb, tag }]. Resolves the chosen index, or -1.
function pickFrom(header, rows, startIdx) {
  return new Promise((resolve) => {
    if (!rows.length) return resolve(-1);
    let sel = startIdx >= 0 && startIdx < rows.length ? startIdx : 0;
    const stdin = process.stdin;
    const rawOK = isTTY && stdin.setRawMode;
    const MAXV = Math.min(8, rows.length);   // rows visible at once
    const HEIGHT = MAXV * 2 + 3;             // above-hint + MAXV*2 + below-hint + keys-hint
    let top = 0;

    function draw(first) {
      if (sel < top) top = sel;
      if (sel >= top + MAXV) top = sel - MAXV + 1;
      const parts = [top > 0 ? dim(`  ⋯ ${top} more above`) : ""];
      for (let i = top; i < top + MAXV; i++) {
        const r = rows[i], on = i === sel;
        const tag = r.tag ? ember(` ${r.tag}`) : "";
        const num = on ? emberBold(`${i + 1}.`) : dim(`${i + 1}.`);
        const arrow = on ? ember("› ") : "  ";
        const name = on ? emberBold(r.title) : bold(r.title);
        parts.push(`${arrow}${num} ${name}${tag}  ${dim(r.meta)}`);
        parts.push(`     ${dim(r.blurb)}`);
      }
      parts.push(top + MAXV < rows.length ? dim(`  ⋯ ${rows.length - top - MAXV} more below`) : "");
      parts.push(dim("↑/↓ move · 1–9 jump · enter confirm · esc cancel"));
      process.stdout.write((first ? header : `\x1b[${HEIGHT}A\x1b[0J`) + parts.join("\n") + "\n");
    }
    draw(true);

    // Take sole control of stdin for the duration of the pick: detach any
    // existing keypress listeners (e.g. the paused readline), then restore them
    // on finish. Without resuming the stream no keypress events would flow.
    const prevKeypress = stdin.listeners("keypress").slice();
    stdin.removeAllListeners("keypress");
    if (rawOK) stdin.setRawMode(true);
    readline.emitKeypressEvents(stdin);
    stdin.resume();
    const onKey = (_str, k) => {
      if (!k) return;
      if (k.name === "up" || k.name === "k") { sel = (sel - 1 + rows.length) % rows.length; draw(false); }
      else if (k.name === "down" || k.name === "j") { sel = (sel + 1) % rows.length; draw(false); }
      else if (/^[1-9]$/.test(k.name || "")) { const n = parseInt(k.name, 10) - 1; if (n < rows.length) { sel = n; draw(false); } }
      else if (k.name === "return") finish(sel);
      else if (k.name === "escape" || (k.ctrl && k.name === "c") || k.name === "q") finish(-1);
    };
    function finish(idx) {
      stdin.removeListener("keypress", onKey);
      if (rawOK) stdin.setRawMode(false);
      // Hand stdin back to whoever held it before (the paused readline).
      prevKeypress.forEach((l) => stdin.on("keypress", l));
      process.stdout.write(`\x1b[${HEIGHT}A\x1b[0J`); // wipe the picker
      resolve(idx);
    }
    stdin.on("keypress", onKey);
  });
}

// Pick a chat model to run (the ✦ catalog, in the terminal).
async function pickModel(catalog, runningId) {
  const chat = catalog.filter((m) => m.category === "chat");
  if (!chat.length) return null;
  const header = `\n${bold("Select Model")}\n${dim("Run any of these on your workspace — the terminal and the model, as one.")}\n\n`;
  const rows = chat.map((m) => ({ title: m.name, meta: `${m.params} · ${m.family}`, blurb: m.blurb, tag: m.id === runningId ? "(current)" : "" }));
  const idx = await pickFrom(header, rows, chat.findIndex((m) => m.id === runningId));
  return idx < 0 ? null : chat[idx];
}

// Pick a CLI agent to install / run (the ◆ catalog, in the terminal).
async function pickAgent(catalog, installed) {
  if (!catalog.length) return null;
  const header = `\n${bold("Agents")}\n${dim("CLI coding agents — install into your terminal, run against your free model or your own key.")}\n\n`;
  const rows = catalog.map((a) => ({
    title: a.name,
    meta: `${a.vendor}${a.openSource ? " · open source" : ""}`,
    blurb: a.blurb,
    tag: installed[a.id] ? "installed ✓" : "",
  }));
  const idx = await pickFrom(header, rows, 0);
  return idx < 0 ? null : catalog[idx];
}

// --- start screen -----------------------------------------------------------
function homePath() {
  const cwd = process.cwd(), home = process.env.HOME || "";
  return home && cwd.startsWith(home) ? "~" + cwd.slice(home.length) : cwd;
}
function banner(snap) {
  const running = snap && snap.running && snap.running.status !== "stopped" ? snap.running : null;
  const backend = snap ? snap.backend : "";
  const modelLine = running ? `${bold(running.name)} ${dim("·")} ${ember("running")}` : `${dim("no model")} ${dim("·")} ${amber("idle")}`;
  const be = backend === "stub" ? dim(" · demo") : backend ? dim(` · ${backend}`) : "";
  const lg = logo();
  const info = [
    `${emberBold("hearth")}  ${dim("v" + VERSION)}`,
    `${modelLine}${be}   ${dim("/model")}`,
    `${dim(homePath())}`,
    ``,
  ];
  let out = "\n";
  for (let i = 0; i < Math.max(lg.length, info.length); i++) {
    out += "  " + (lg[i] || "    ") + "   " + (info[i] || "") + "\n";
  }
  out += `${dim("Tip:")} ${dim("type")} ${emberBold("/model")} ${dim("for models,")} ${emberBold("/agents")} ${dim("for agents,")} ${emberBold("/help")} ${dim("for commands.")}\n\n`;
  return out;
}

// --- REPL -------------------------------------------------------------------
async function repl() {
  let snap = await snapshot();
  process.stdout.write(banner(snap));

  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, prompt: ember("› ") });
  const history = [];
  rl.prompt();

  rl.on("line", async (line) => {
    const text = line.trim();
    if (!text) return rl.prompt();

    if (text[0] === "/") {
      const [cmd] = text.slice(1).split(/\s+/);
      if (cmd === "help") {
        process.stdout.write(
          `\n  ${emberBold("/model")}    ${dim("pick + start a model")}\n` +
          `  ${emberBold("/agents")}   ${dim("install + run a CLI agent (Claude Code, Aider…)")}\n` +
          `  ${emberBold("/clear")}    ${dim("clear the conversation")}\n` +
          `  ${emberBold("/help")}     ${dim("this list")}\n` +
          `  ${emberBold("Ctrl-D")}    ${dim("exit")}\n\n`
        );
        return rl.prompt();
      }
      if (cmd === "clear") { history.length = 0; process.stdout.write("\x1b[2J\x1b[H" + banner(snap)); return rl.prompt(); }
      if (cmd === "model") {
        snap = (await snapshot()) || snap;
        if (!snap || !snap.catalog) { process.stdout.write(`\n${dim("model catalog unavailable (is this a Hearth workspace?)")}\n\n`); return rl.prompt(); }
        rl.pause();
        const runningId = snap.running && snap.running.status !== "stopped" ? snap.running.modelId : null;
        const choice = await pickModel(snap.catalog, runningId);
        if (choice) {
          if (choice.id === runningId) process.stdout.write(`${dim("keeping")} ${bold(choice.name)}\n\n`);
          else {
            process.stdout.write(`${dim("starting")} ${bold(choice.name)}${dim("…")}`);
            try { const r = await startModel(choice.id); process.stdout.write(`\r${ember("✓")} ${bold(r.name)} ${dim("running")}          \n\n`); snap = (await snapshot()) || snap; }
            catch (e) { process.stdout.write(`\r${amber("×")} ${dim(String(e.message))}          \n\n`); }
          }
        } else process.stdout.write("\n");
        rl.resume();
        return rl.prompt();
      }
      if (cmd === "agents") {
        const a = await agentsSnapshot();
        if (!a || !a.catalog) { process.stdout.write(`\n${dim("agent catalog unavailable (is this a Hearth workspace?)")}\n\n`); return rl.prompt(); }
        rl.pause();
        const choice = await pickAgent(a.catalog, a.installed);
        if (choice) {
          const free = choice.brain !== "byok";
          if (!a.installed[choice.id]) {
            // One step: install, then launch it (open-source → your free model).
            process.stdout.write(`${dim("installing + launching")} ${bold(choice.name)}${free ? dim(" · your free model") : ""}${dim(" …")}\n${dim("$ " + choice.install)}\n`);
            await runShell(`${choice.install} && ${choice.run}`, free);
            process.stdout.write("\n");
          } else {
            process.stdout.write(`${ember("▶")} ${bold(choice.name)}${free ? dim(" · your free model") : ""}\n\n`);
            await runShell(choice.run, free);
            process.stdout.write("\n");
          }
        } else process.stdout.write("\n");
        rl.resume();
        return rl.prompt();
      }
      process.stdout.write(`\n${dim(`unknown command: /${cmd} — try /help`)}\n\n`);
      return rl.prompt();
    }

    history.push({ role: "user", content: text });
    process.stdout.write(emberBold("✦") + "\n");
    rl.pause();
    const reply = await stream(history);
    history.push({ role: "assistant", content: reply });
    rl.resume();
    rl.prompt();
  });

  rl.on("close", () => { process.stdout.write(`\n${dim("bye.")}\n`); process.exit(0); });
}

async function main() {
  const args = process.argv.slice(2);
  if (args.length && args[0] !== "chat") {
    const q = args[0] === "ask" ? args.slice(1).join(" ") : args.join(" ");
    if (q.trim()) await stream([{ role: "user", content: q }]);
    return;
  }
  await repl();
}

main();
