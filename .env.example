# --- Terminal bridge (server) ---
PORT=3001

# The shell the terminal spawns inside the container (defaults to /bin/bash).
# SHELL=/bin/bash

# --- Session persistence ---
# Where scrollback is persisted so sessions replay after reconnect / restart.
# Defaults to $HOME/.hearth/sessions (which lives on the persistent volume).
# HEARTH_STATE_DIR=/home/hearth/.hearth/sessions

# --- Auth (optional) ---
# Auth is OFF by default (dev). To require a password, set all three:
# HEARTH_REQUIRE_AUTH=true
# HEARTH_PASSWORD=change-me
# HEARTH_JWT_SECRET=a-long-random-secret
