# --- Terminal bridge (server) ---
PORT=3001

# --- Hermes CLI agent (runs inside the container) ---
# STUB_INFERENCE=true uses a deterministic mock so you can try `hermes`
# with no model running. Set it to false and point at a real endpoint to go live.
STUB_INFERENCE=true
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
INFERENCE_API_KEY=none
