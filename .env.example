# --- Terminal bridge (server) ---
PORT=3001

# The shell the terminal spawns inside the container (defaults to /bin/bash).
# SHELL=/bin/bash

# --- Session persistence ---
# Where scrollback is persisted so sessions replay after reconnect / restart.
# Defaults to $HOME/.hearth/sessions (which lives on the persistent volume).
# HEARTH_STATE_DIR=/home/hearth/.hearth/sessions

# --- Auth (optional) ---
# Auth is OFF by default (dev). To require a password, set all three:
# HEARTH_REQUIRE_AUTH=true
# HEARTH_PASSWORD=change-me
# HEARTH_JWT_SECRET=a-long-random-secret

# --- Phase 2: control plane (machines, GPU, metering, billing) ---
# Orchestration backend: local (default, in-process) | docker | kubernetes
# HEARTH_PROVIDER=local
# HEARTH_WORKSPACE_IMAGE=hearth-workspace:latest   # for docker/kubernetes
# HEARTH_K8S_NAMESPACE=hearth                       # for kubernetes
# Scale-to-zero: sleep a machine after this much idle time (ms).
# HEARTH_IDLE_MS=900000
# Billing: set a Stripe TEST key to enable real (test-mode) charges; else simulated.
# STRIPE_SECRET_KEY=sk_test_...
# GPU backend: set a RunPod key to provision real on-demand GPU pods; else a mock.
# RUNPOD_API_KEY=...
# RUNPOD_IMAGE=runpod/base:latest

# --- Open-model runner ---
# Backend that actually serves models. Default = stub (deterministic, no GPU).
# Set to "ollama" (ollama installed in the workspace) to serve real models.
# HEARTH_MODEL_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
