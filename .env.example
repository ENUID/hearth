# --- Terminal bridge (server) ---
PORT=3001

# The shell the terminal spawns inside the container (defaults to /bin/bash).
# SHELL=/bin/bash

# --- Session persistence ---
# Where scrollback is persisted so sessions replay after reconnect / restart.
# Defaults to $HOME/.hearth/sessions (which lives on the persistent volume).
# HEARTH_STATE_DIR=/home/hearth/.hearth/sessions

# --- Instance / org settings (self-host) ---
# Name shown on the login screen.
# HEARTH_INSTANCE_NAME=Hearth
# Allow new accounts (multi-user mode). Set false once your team is set up;
# the very first account is always allowed so you can bootstrap.
# HEARTH_SIGNUPS_OPEN=true

# --- Auth (pick ONE approach) ---
# A) Single shared password — set all three:
# HEARTH_REQUIRE_AUTH=true
# HEARTH_PASSWORD=change-me
# HEARTH_JWT_SECRET=a-long-random-secret
# B) Multi-user accounts + teams (per-user isolation, shared team workspaces):
# HEARTH_MULTIUSER=true
# HEARTH_JWT_SECRET=a-long-random-secret   # e.g. openssl rand -hex 32

# --- Phase 2: control plane (machines, GPU, metering, billing) ---
# Orchestration backend: local (default, in-process) | docker | kubernetes | fly
# HEARTH_PROVIDER=local
# HEARTH_WORKSPACE_IMAGE=hearth-workspace:latest   # for docker/kubernetes/fly
# HEARTH_K8S_NAMESPACE=hearth                       # for kubernetes
# Fly.io machines provider (a microVM per workspace — best for untrusted users):
# FLY_API_TOKEN=...            # fly auth token
# FLY_APP_NAME=hearth
# FLY_REGION=iad

# --- Terminal isolation (untrusted multi-tenant) ---
# By default the terminal spawns a shell on the HOST (single-user / dev). For
# untrusted users, exec into the workspace's own container/microVM instead so
# terminals are OS-isolated. `{workspace}` is substituted with the workspace id.
#   docker: HEARTH_SHELL_CMD="docker exec -it hearth-{workspace} bash"
#   fly:    HEARTH_SHELL_CMD="flyctl ssh console -a hearth -m {workspace} -C /bin/bash"
#   k8s:    HEARTH_SHELL_CMD="kubectl exec -it hearth-{workspace} -- bash"
# HEARTH_SHELL_CMD=
# Scale-to-zero: sleep a machine after this much idle time (ms).
# HEARTH_IDLE_MS=900000
# Billing: set a Stripe TEST key to enable real (test-mode) charges; else simulated.
# STRIPE_SECRET_KEY=sk_test_...
# GPU backend: set a RunPod key to provision real on-demand GPU pods; else a mock.
# RUNPOD_API_KEY=...
# RUNPOD_IMAGE=runpod/base:latest

# --- Open-model runner ---
# Chat backend that actually serves models. Default = stub (deterministic, no GPU).
# Set to "ollama" (ollama installed in the workspace) to serve real models.
# HEARTH_MODEL_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
#
# Image backend (FLUX / SDXL etc.). Default = stub (returns a placeholder PNG).
# Set to "comfyui" and point at a running ComfyUI server to render for real.
# HEARTH_IMAGE_BACKEND=comfyui
# COMFYUI_URL=http://localhost:8188
